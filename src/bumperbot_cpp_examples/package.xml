<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bumperbot_cpp_examples</name>
  <version>0.0.0</version>
  <description>Example C++ nodes for parameter handling, publishing, and subscribing in ROS2</description>
  <maintainer email="bouha@todo.todo">Ahmed Bouhachem</maintainer>
  <license>Apache-2.0</license>

  <author email="bouha@todo.todo">Ahmed Bouhachem</author>

  <!-- Build tool used by ROS 2 ament system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core runtime dependencies for the example nodes -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>turtlesim</depend>
  <depend>tf2_ros</depend>
  <depend>bumperbot_msgs</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_components</depend>
  <depend>rclcpp_lifecycle</depend>
  <exec_depend>rclpy</exec_depend>

  <!-- Linting (optional) -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

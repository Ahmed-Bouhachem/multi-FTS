<?xml version="1.0"?>

<robot name="bumperbot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Macro that injects Gazebo / gz_ros2_control plugins for a namespaced robot.
       is_primary=true loads world-level singleton system plugins (Sensors, IMU).
       Set is_primary=false on all but one robot in a multi-robot scene — loading
       those plugins twice crashes Ogre2 (libGLdispatch segfault). -->
  <xacro:macro name="bumperbot_gazebo" params="ros_namespace is_primary:=true">

    <!-- Wheels -->
    <gazebo reference="wheel_left_link">
      <mu1>1000000000000000.0</mu1>
      <mu2>1000000000000000.0</mu2>
      <kp>1000000000000.0</kp>
      <kd>10.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.1</maxVel>
      <fdir1>1 0 0</fdir1>
    </gazebo>

    <gazebo reference="wheel_right_link">
      <mu1>1000000000000000.0</mu1>
      <mu2>1000000000000000.0</mu2>
      <kp>1000000000000.0</kp>
      <kd>10.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.1</maxVel>
      <fdir1>1 0 0</fdir1>
    </gazebo>

    <!-- Caster Wheels -->
    <gazebo reference="caster_rear_link">
      <mu1>0.1</mu1>
      <mu2>0.1</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>1.0</maxVel>
    </gazebo>

    <gazebo reference="caster_front_link">
      <mu1>0.1</mu1>
      <mu2>0.1</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>1.0</maxVel>
    </gazebo>

    <!-- ROS 2 Control + sensors plugins -->
    <gazebo>
      <!-- ROS 2 Humble / Ignition path -->
      <xacro:if value="$(arg is_ignition)">
        <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
          <ros>
            <namespace>${ros_namespace}</namespace>
            <!-- Redirect TF to namespaced topic so each robot owns its TF tree.
                 When ros_namespace="" (single robot) this resolves to /tf — no change. -->
            <remapping>/tf:=tf</remapping>
            <remapping>/tf_static:=tf_static</remapping>
          </ros>
          <parameters>$(find bumperbot_controller)/config/bumperbot_controllers.yaml</parameters>
        </plugin>
        <xacro:if value="${is_primary}">
          <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
          <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
            <!-- Use Ogre2 rendering so GPU lidar works correctly -->
            <render_engine>ogre2</render_engine>
          </plugin>
        </xacro:if>
      </xacro:if>

      <!-- ROS 2 Iron+ / gz_sim path -->
      <xacro:unless value="$(arg is_ignition)">
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <ros>
            <namespace>${ros_namespace}</namespace>
            <remapping>/tf:=tf</remapping>
            <remapping>/tf_static:=tf_static</remapping>
          </ros>
          <parameters>$(find bumperbot_controller)/config/bumperbot_controllers.yaml</parameters>
        </plugin>
        <xacro:if value="${is_primary}">
          <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
          <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
            <!-- Use Ogre2 rendering so GPU lidar works correctly -->
            <render_engine>ogre2</render_engine>
          </plugin>
        </xacro:if>
      </xacro:unless>
    </gazebo>

    <!-- IMU -->
    <gazebo reference="imu_link">
      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <gz_frame_id>imu_link</gz_frame_id>
        <!-- Namespace IMU topic per robot so multi-robot setups do not collide -->
        <topic>/${ros_namespace}/imu</topic>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>

    <!-- 2D Laser Sensor for Nav2 / SLAM.
         Topics are namespaced per robot using ros_namespace so that
         /robot1/scan, /robot2/scan, ... can be bridged independently. -->
    <gazebo reference="laser_link">
      <sensor name="gpu_lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <gz_frame_id>laser_link</gz_frame_id>
        <!-- Pose is relative to laser_link via the gazebo reference -->
        <pose>0 0 0 0 0 0</pose>
        <!-- Namespace scan topic for multi-robot setups -->
        <topic>/${ros_namespace}/scan</topic>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-1.5708</min_angle>
              <max_angle>1.5708</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0.0</min_angle>
              <max_angle>0.0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.12</min>
            <max>3.5</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <visualize>true</visualize>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
